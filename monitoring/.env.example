# monitoring/.env 로 복사해서 쓴다. compose 가 자동으로 읽는다.
#   cp monitoring/.env.example monitoring/.env
#
# .env 는 .gitignore 에 있어 커밋되지 않는다.
# 비밀번호를 여기 두면 명령 히스토리에도 남지 않는다.

# Redis 비밀번호. 서버에 requirepass 가 걸려 있으면 반드시 필요하다.
# 없으면 비워 두거나 줄 전체를 지운다.
REDIS_PASSWORD=

# Redis 주소. 닿지 않으면 사설 IP 를 먼저 시도한다.
#REDIS_ADDR=2mtest.liz.com:6379

#REDIS_DB=0
#REDIS_KEY=liz.stats.server.modbus.network.traffic

# Grafana 관리자 비밀번호. 지정하면 기동할 때마다 강제로 다시 설정한다.
#GRAFANA_PASSWORD=

# Grafana 바인드 주소. 127.0.0.1 로 두면 외부에서 접속할 수 없다.
#GRAFANA_BIND=0.0.0.0
