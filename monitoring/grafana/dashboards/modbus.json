{
  "title": "Modbus Slave 에뮬레이터",
  "uid": "modbus-slave",
  "tags": [
    "modbus"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 10,
      "title": "콜렉터별 아웃바운드",
      "type": "timeseries",
      "description": "포트 범위를 monitoring/collectors.conf 로 콜렉터에 대응시켜 묶은 값.",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "expr": "sum by (collector) (modbus_slave_transmit_mbps)",
          "legendFormat": "{{collector}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Mbits",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 20,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "title": "콜렉터 서버별 아웃바운드",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (server) (modbus_slave_transmit_mbps)",
          "legendFormat": "{{server}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Mbits",
